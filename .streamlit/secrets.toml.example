# 이 파일을 secrets.toml로 복사한 뒤 발급받은 키를 입력하세요.
# 같은 키를 사용하더라도 API마다 활용신청과 승인이 필요합니다.
[public_data]
service_key = "YOUR_SERVICE_KEY"
# API별 다른 키를 쓰는 경우에만 아래 값을 설정하세요.
# price_key = "YOUR_PRICE_KEY"
# stores_key = "YOUR_STORES_KEY"
# catalogue_key = "YOUR_CATALOGUE_KEY"
# nutrition_key = "YOUR_NUTRITION_KEY"
price_ttl = 21600
stores_ttl = 86400
catalogue_ttl = 86400
nutrition_ttl = 604800
